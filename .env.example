DASHBOARD_PORT=3001
MOCK_SAP_PORT=4000
ADMINER_PORT=8080
MOCK_SAP_MODE=success
MOCK_SAP_DELAY_MS=0
MOCK_SAP_ADMIN_TOKEN=local-dashboard-token
# Used by the dashboard container; keep credentials aligned with the order-sync stack.
ORDER_SYNC_DATABASE_URL=postgresql://order_sync:order_sync@postgres:5432/order_sync
# Used when running the dashboard directly on the host.
DATABASE_URL=postgresql://order_sync:order_sync@localhost:5432/order_sync
HARDWARE_SYNC_DELAY_SECONDS=30
WEBHOOK_SECRET=
